//Pointer and Array in C

#include <stdio.h>

int main() {
    int a[5] = {10, 20, 30, 40, 50};
    int *p;
    p = &a[0];

    printf("\n\n");
    printf("&a[0] = %p\n", (void *)&a[0]);
    printf("p = %p\n", (void *)p); // Memory Address
    printf("*p = %d\n", *p);       // Value

    p++;
    printf("\n\n");
    printf("p = %p\n", (void *)p);
    printf("*p = %d\n", *p);

    printf("\n\n");
    printf("a+1 = %p\n", (void *)(a+1)); // a++ / a=a+1 is not correct
    printf("*(a+1) = %d\n", *(a+1));

    printf("\n\n");
    // Print all elements
    p = &a[0]; // Reset pointer to start of array
    for(int i = 0; i < 5; i++){
        printf("*p = %d  ", *p);
        p++;
    }
    printf("\n");
    return 0;
}

