//Pointer - Call by the Value/Reference in C

#include<stdio.h>
void modifyvalue(int *a, int *b){
     *a=15;
     *b=25;
}


int main()
{
    int x=10,y=20;

    printf("\n\n");
    printf("Before Call By the value:\n");
    printf("x=%d,y=%d\n",x,y);

    modifyvalue(&x,&y);

    printf("\n\n");
    printf("Call By the Reference:\n");
    printf("x=%d,y=%d\n",x,y);

    return 0;

}
