//Pointer Arithmetic in C

#include<stdio.h>
#include<string.h>
int main()
{

    int a=10, b=20;
    int *p, *q;

    p=&a;
    q=&b;

    printf("\n\n");
    printf("a=%d and b=%d\n", a,b);
    printf("*p=%d and *q=%d\n", *p,*q);
    printf("*p + *q = %d\n", *p + *q);

    (*p)++;
    (*q)--;

    printf("\n\n");
    printf("a=%d and b=%d\n", a,b);
    printf("*p=%d and *q=%d\n", *p,*q);
    printf("*p + *q = %d\n", *p + *q);

    *p = *p+3; //*p +=3
    *q = *q-5; //*q --5
    printf("\n\n");
    printf("a=%d and b=%d\n", a,b);
    printf("*p=%d and *q=%d\n", *p,*q);
    printf("*p + *q = %d\n", *p + *q);



    return 0;

}
