#include<stdio.h>

struct Student{ //Global Structure - It can be Used every Function
     int id;
     char *name;
    };

struct Student s;//Global variable - It can be Used every Function

void displayStudent(){

    printf("ID : %d\n",s.id);
    printf("Name : %s\n",s.name);
}

int main() {


    s.id = 101;
    s.name ="Mahi";
    displayStudent();

    s.id = 101;
    s.name ="Nahian";
    displayStudent();

    return 0;
}
