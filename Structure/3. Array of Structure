// Array of Structure in C

#include<stdio.h>
#include<conio.h>
#include<string.h>

#define Total_Products 2 //Onek gulu product nite parbe. 5 dile 5 ta box hobe, array er modde 2 tar information dile baki box gulu khali thakbe.

int main()
{
    //define Structure for a product
    struct Product{
           int id;
           char name[50];
           char category[20];
           float price;
           int quantity;
    };
    struct Product products[Total_Products]={
    {101,"Laptop XYZ", "Electronics", 1200.00, 15},
    {101,"Coffe", "Grocery", 15.99, 100}
    };

    for(int i=0; i<Total_Products; i++){
        printf("ID : %d\n", products[i].id);
        printf("Name : %s\n", products[i].name);
        printf("Category : %s\n", products[i].category);
        printf("Price : %.2f\n", products[i].price);
        printf("Quantity : %d\n\n\n", products[i].quantity);
    }

    return 0;
}
