// Structure in C

#include<stdio.h>
#include<conio.h>
#include<string.h>

int main()
{
    //define Structure for a product
    struct Product{
           int id;
           char name[50];
           char category[20];
           float price;
           int quantity;
    };
    //Structure e access korar jonno vareable nilam.
    struct Product product_1,product_2;

    product_1.id = 101;
    strcpy(product_1.name, "Laptop XYZ");
    strcpy(product_1.category, "Electronics");
    product_1.price = 49.99;
    product_1.quantity = 50;

    printf("id : %d\n", product_1.id);
    printf("Name : %s\n", product_1.name);
    printf("Category : %s\n", product_1.category);
    printf("Price : %.2f\n", product_1.price);
    printf("Quantity : %d\n", product_1.quantity);

    product_2.id = 101;
    strcpy(product_2.name, "Coffe");
    strcpy(product_2.category, "Grocery");
    product_2.price = 49.99;
    product_2.quantity = 50;

    printf("\n\nid : %d\n", product_2.id);
    printf("Name : %s\n", product_2.name);
    printf("Category : %s\n", product_2.category);
    printf("Price : %.2f\n", product_2.price);
    printf("Quantity : %d\n", product_2.quantity);

    return 0;
}
